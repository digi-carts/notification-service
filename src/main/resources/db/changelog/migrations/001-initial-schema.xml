<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-schema" author="digi-cart">
        <validCheckSum>ANY</validCheckSum>
        <sql>CREATE SCHEMA IF NOT EXISTS notif_svc</sql>
    </changeSet>

    <changeSet id="002-create-notification-config" author="digi-cart">
        <createTable tableName="notification_config" schemaName="notif_svc">
            <column name="id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="smtp_host" type="VARCHAR(255)"/>
            <column name="smtp_port" type="INTEGER"/>
            <column name="smtp_user" type="VARCHAR(255)"/>
            <column name="smtp_password" type="VARCHAR(255)"/>
            <column name="smtp_from" type="VARCHAR(255)"/>
            <column name="email_enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="wa_provider" type="VARCHAR(50)"/>
            <column name="wa_api_key" type="VARCHAR(255)"/>
            <column name="wa_phone_id" type="VARCHAR(255)"/>
            <column name="wa_account_sid" type="VARCHAR(255)"/>
            <column name="wa_auth_token" type="VARCHAR(255)"/>
            <column name="wa_enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="alert_order_placed" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="alert_order_shipped" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="alert_order_delivered" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="alert_order_cancelled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="alert_order_refunded" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="003-create-notification-log" author="digi-cart">
        <createTable tableName="notification_log" schemaName="notif_svc">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="store_id" type="VARCHAR(255)"/>
            <column name="channel" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="event" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="recipient" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="error" type="TEXT"/>
            <column name="sent_at" type="TIMESTAMPTZ"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="notification_log" schemaName="notif_svc" indexName="idx_notif_log_store_id">
            <column name="store_id"/>
        </createIndex>

        <createIndex tableName="notification_log" schemaName="notif_svc" indexName="idx_notif_log_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
